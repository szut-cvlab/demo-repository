---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecHead from '../components/SecHead.astro';
import { linkify } from '../lib/linkify';
import { getCollection } from 'astro:content';

const entry = (await getCollection('projects'))[0];
const items = entry?.data.items ?? [];
---

<BaseLayout title="开源项目 · 视觉与低空智能实验室">
  <section class="py-12" data-reveal>
    <SecHead no="04" title="开源项目" en="OPEN SOURCE" />
    <p class="-mt-2 mb-8 max-w-[36em] text-[15px] text-fog">
      实验室维护与开源的算法、应用、工具、模型、数据集与评测基准。
    </p>
    <ul>
      {
        items.map((pr, i) => (
          <li class="grid gap-2 border-b border-line py-6 transition-colors duration-200 hover:bg-panel sm:grid-cols-[44px_1fr_auto] sm:gap-5">
            <span class="pt-1 font-mono text-xs text-fog">
              S-{String(items.length - i).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-xl font-extrabold leading-snug">
                {pr.url ? (
                  <a href={pr.url} class="hover:text-mark hover:underline">
                    {pr.name}
                  </a>
                ) : (
                  pr.name
                )}
              </h3>
              {pr.desc && (
                <p class="mt-1.5 text-[15px] text-fog" set:html={linkify(pr.desc)} />
              )}
            </div>
            <div class="flex items-start gap-2 sm:pt-1">
              {pr.language && (
                <span class="border border-ink px-2 py-1 font-mono text-[11px] tracking-wide text-ink">
                  {pr.language}
                </span>
              )}
              {pr.url && pr.url !== '#' && (
                <a
                  href={pr.url}
                  target="_blank"
                  rel="noopener"
                  class="bg-ink px-2 py-1 font-mono text-[11px] tracking-wide text-paper transition-colors duration-200 hover:bg-mark"
                >
                  REPO ↗
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
